{
  "model": {
    "vocab_size": 128,
    "max_seq_len": 16,
    "d_model": 32,
    "n_heads": 2,
    "n_layers": 2,
    "mlp_ratio": 4,
    "norm_eps": 1e-05
  },
  "train": {
    "steps": 4,
    "batch_size": 2,
    "grad_accum": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 1e-08,
    "clip_grad_norm": 1.0,
    "warmup_steps": 1,
    "min_lr_ratio": 0.1,
    "eval_interval": 2,
    "eval_batches": 2,
    "checkpoint_steps": [
      0,
      2,
      4
    ],
    "checkpoint_interval": 2,
    "precision": "fp32",
    "device": "cpu",
    "deterministic": true
  },
  "study": {
    "phase": "smoke",
    "synthetic_allowed": true,
    "primary_endpoint": "endpoint_kl_mean at alpha=1, standard trajectory final checkpoint",
    "primary_comparison": "q_detach vs standard",
    "seeds": [
      11
    ],
    "measurement_seq_len": 16,
    "measurement_batch_size": 1
  }
}
